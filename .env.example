# ==============================================================================
# Daroodi environment configuration
#
# Copy this file to `.env.local` and fill in the real values.
# DO NOT COMMIT `.env.local` — it is in .gitignore.
# ==============================================================================

# Supabase project URL (from Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Anon / publishable key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Service role / secret key — NEVER expose to the browser. Server-only.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-KEY
